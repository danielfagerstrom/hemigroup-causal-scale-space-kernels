{
  "extraKnownMarketplaces": {
    "article-kit": {
      "source": {
        "source": "github",
        "repo": "danielfagerstrom/article-kit"
      }
    }
  },
  "enabledPlugins": {
    "article-kit@article-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(python bin/snapshot.py:*)",
      "Bash(python3 bin/snapshot.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-setup.sh\""
          }
        ]
      }
    ]
  }
}
